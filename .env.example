# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN pernah commit .env.local. File ini hanya berisi NAMA variabel.

# --- RAHASIA: hanya dipakai di server, JANGAN pakai awalan NEXT_PUBLIC_ ---
GEMINI_API_KEY=

# --- Pengaturan chatbot (bukan rahasia, nilai awal boleh diubah) ---
GEMINI_MODEL=
CHATBOT_ENABLED=true
CHAT_MAX_INPUT_CHARS=500
CHAT_MAX_HISTORY_MESSAGES=6
CHAT_MAX_OUTPUT_TOKENS=400
# Variabel penyimpanan batas penggunaan ditambah setelah keputusannya dicatat di docs/DECISIONS.md

# --- Publik: boleh terlihat di browser, bukan rahasia ---
NEXT_PUBLIC_SITE_URL=